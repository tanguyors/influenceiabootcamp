{
  "name": "Influencer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de l'influenceur"
    },
    "notes": {
      "type": "string",
      "description": "Notes: style, tenue habituelle, ton"
    },
    "reference_image": {
      "type": "string",
      "description": "file_uri de l'image de r\u00e9f\u00e9rence (stockage priv\u00e9)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}